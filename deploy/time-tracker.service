# Install: copy to /etc/systemd/system/time-tracker.service, edit the
# placeholders, then: sudo systemctl daemon-reload && sudo systemctl enable --now time-tracker
#
# ExecStart points at a stable symlink in the deploy user's home so nvm node
# upgrades don't break the unit. The deploy refreshes it every run (no sudo).
# Manual refresh: ln -sfn "$(readlink -f "$(nvm which current)")" ~/bin/tt-node

[Unit]
Description=time-tracker
After=network.target

[Service]
Type=simple
User=DEPLOY_USER
WorkingDirectory=/home/DEPLOY_USER/time-tracker
ExecStart=/home/DEPLOY_USER/bin/tt-node dist/src/server.js
Restart=on-failure
RestartSec=3
# App loads .env via dotenv; nothing else needed here.

[Install]
WantedBy=multi-user.target
