<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title><%= title %></title>
  <% const v = version.hash %>
  <link rel="stylesheet" href="/app.css?v=<%= v %>">
  <script src="/vendor/htmx.min.js?v=<%= v %>" defer></script>
  <script src="/app.js?v=<%= v %>" defer></script>
</head>
<body class="<%= (typeof nav !== 'undefined' && nav) ? 'app' : 'auth' %>">
  <% if (typeof nav !== 'undefined' && nav) { %>
  <nav class="tabbar">
    <a href="/" class="<%= nav==='tracking'?'active':'' %>"><span class="ico"><%- include('partials/icon', { name:'clock' }) %></span><span class="lbl">Time</span></a>
    <a href="/tasks" class="<%= nav==='tasks'?'active':'' %>"><span class="ico"><%- include('partials/icon', { name:'list' }) %></span><span class="lbl">Tasks</span></a>
    <a href="/analytics" class="<%= nav==='analytics'?'active':'' %>"><span class="ico"><%- include('partials/icon', { name:'chart' }) %></span><span class="lbl">Stats</span></a>
    <a href="/settings" class="<%= nav==='settings'?'active':'' %>"><span class="ico"><%- include('partials/icon', { name:'gear' }) %></span><span class="lbl">Settings</span></a>
  </nav>
  <% } %>
  <main class="<%= (typeof wide !== 'undefined' && wide) ? 'wide' : '' %>"><%- body %></main>
</body>
</html>
