<div class="wu-fields">
  <textarea name="details" placeholder="Details"><%= s && s.details ? s.details : '' %></textarea>
  <div class="task-line">
    <select name="taskId" class="task-select">
      <option value="">(no task)</option>
      <% taskGroups.forEach(g => { %>
        <% const opts = g.tasks.map(t => `<option value="${t.id}"${s && s.task_id === t.id ? ' selected' : ''}>${t.name.replace(/</g,'&lt;')}</option>`).join(''); %>
        <% if (g.client) { %><optgroup label="<%= g.client.name %>"><%- opts %></optgroup><% } else { %><%- opts %><% } %>
      <% }) %>
    </select>
    <input class="qa-input" name="_qtask" placeholder="+ new task" autocomplete="off"
           onchange="event.stopPropagation()"
           onkeydown="if(event.key==='Enter'){event.preventDefault();this.nextElementSibling.click();}">
    <button type="button" class="qa" hx-post="/quick/task" hx-include="previous input"
            hx-target="previous .task-select" hx-swap="beforeend"
            hx-on::after-request="const s=this.closest('.task-line').querySelector('.task-select');s.value=s.lastElementChild.value;this.previousElementSibling.value='';htmx.trigger(this.closest('form'),'change')">Add</button>
  </div>
  <div class="chips">
    <% tags.forEach(t => { const on = s && s.tags && s.tags.some(x => x.id === t.id); %>
      <label class="chip<%= on ? ' on' : '' %>" style="--chip: <%= t.color %>">
        <input type="checkbox" name="tagId" value="<%= t.id %>" <%= on ? 'checked' : '' %>>
        <span><%= t.name %></span>
      </label>
    <% }) %>
  </div>
  <div class="tag-line">
    <input class="qa-input" name="_qtag" placeholder="+ new tag" autocomplete="off"
           onchange="event.stopPropagation()"
           onkeydown="if(event.key==='Enter'){event.preventDefault();this.nextElementSibling.click();}">
    <button type="button" class="qa" hx-post="/quick/tag" hx-include="previous input"
            hx-target="previous .chips" hx-swap="beforeend"
            hx-on::after-request="this.previousElementSibling.value='';htmx.trigger(this.closest('form'),'change')">Add</button>
  </div>
</div>
