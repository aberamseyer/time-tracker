<form class="session-row editing" hx-post="/sessions/<%= s.id %>" hx-target="this" hx-swap="outerHTML">
  <input name="description" value="<%= s.description %>" placeholder="Description"
         list="desc-options" hx-get="/sessions/template" hx-trigger="change" hx-include="this"
         hx-target="next .wu-fields" hx-swap="outerHTML">
  <%- include('wu-fields', { s, taskGroups, tags }) %>
  <div class="time-row">
    <label>Date<input type="date" name="date" value="<%= startAt.date %>"></label>
    <label>Start<input type="time" name="start" value="<%= startAt.time %>"></label>
    <label>End<input type="time" name="end" value="<%= endAt.time %>"></label>
  </div>
<div class="actions">
    <button type="submit">Save</button>
    <button type="button" hx-post="/sessions/<%= s.id %>/delete"
            hx-target="closest .session-row" hx-swap="outerHTML" class="danger" hx-confirm="Delete this session? Its tasks will be moved to No client.">
      Delete
    </button>
  </div>
</form>
