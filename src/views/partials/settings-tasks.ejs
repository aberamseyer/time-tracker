<div id="settings-tasks" class="manage">
  <% tasks.forEach(t => { %>
    <form class="manage-row" hx-post="/settings/tasks/<%= t.id %>" hx-target="#settings-tasks" hx-swap="outerHTML">
      <input type="color" name="color" value="<%= t.color %>">
      <input name="name" value="<%= t.name %>" required>
      <input type="number" step="0.01" name="rate" placeholder="Rate/hr"
             value="<%= t.hourly_rate_cents != null ? (t.hourly_rate_cents / 100).toFixed(2) : '' %>">
      <button title="Save">Save</button>
      <button class="danger" title="Archive" hx-post="/settings/tasks/<%= t.id %>/archive"
              hx-target="#settings-tasks" hx-swap="outerHTML">✕</button>
    </form>
  <% }) %>
  <form class="manage-row new" hx-post="/settings/tasks" hx-target="#settings-tasks" hx-swap="outerHTML">
    <input type="color" name="color" value="#3b82f6">
    <input name="name" placeholder="New task" required>
    <input type="number" step="0.01" name="rate" placeholder="Rate/hr">
    <button>Add</button>
  </form>
</div>
