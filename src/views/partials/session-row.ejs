<div class="session-row" id="s-<%= s.id %>">
  <div class="clickable" hx-get="/sessions/<%= s.id %>/edit" hx-target="closest .session-row" hx-swap="outerHTML">
    <span class="bar" style="background: <%= s.task ? s.task.color : 'var(--line)' %>"></span>
    <div class="meta">
      <div class="title"><%= s.description || '(no description)' %><% if (s.task) { %> · <span class="task"><%= s.task.name %></span><% } %></div>
      <div class="tags">
        <% s.tags.forEach(t => { %><span class="tag" style="--chip: <%= t.color %>"><%= t.name %></span><% }) %>
      </div>
    </div>
    <span class="dur"><%= fmtDuration(s.roundedMs) %></span>
  </div>
  <form hx-post="/timer/start-from/<%= s.id %>" hx-target="#active-timer" hx-swap="outerHTML" class="row-play">
    <button class="resume" title="Start again">▶</button>
  </form>
</div>
