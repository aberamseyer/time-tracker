<%
  const filterQS = (p.clientId ? `&clientId=${p.clientId}` : '')
    + p.taskIds.map(id => `&taskId=${id}`).join('')
    + p.tagIds.map(id => `&tagId=${id}`).join('');
  const base = `by=${p.by}&metric=${p.metric}&chart=${p.chart}&type=${p.type}${filterQS}`;
  const qs = `${base}&ps=${p.ps}`;
  function esc(s){return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');}
  const fmtVal = report.metric === 'earnings' ? (v) => fmtMoney(v) : (v) => fmtDuration(v);
  const buckets = report.buckets, series = report.series;
  const W = 720, H = 240, x0 = 46, x1 = 710, yT = 12, yB = 214;
  const plotW = x1 - x0, plotH = yB - yT;
  const nb = Math.max(1, buckets.length);
  const band = plotW / nb;
  const step = Math.ceil(nb / 8);
  let max = 1;
  if (p.chart === 'bars') {
    buckets.forEach((d, i) => { const sum = series.reduce((n, s) => n + s.values[i], 0); if (sum > max) max = sum; });
  } else {
    series.forEach(s => s.values.forEach(v => { if (v > max) max = v; }));
  }
  const yOf = (v) => yB - (v / max) * plotH;
  const seg = (name, cur, opts) => opts.map(([v, label]) =>
    `<label class="seg${cur === v ? ' on' : ''}"><input type="radio" name="${name}" value="${v}" ${cur === v ? 'checked' : ''}><span>${label}</span></label>`).join('');
%>
<div id="analytics" hx-get="/partials/analytics-panel?<%= qs %>" hx-trigger="tt:changed from:body" hx-swap="outerHTML">
  <form class="an-controls" hx-get="/partials/analytics-panel" hx-target="#analytics" hx-swap="outerHTML" hx-trigger="change">
    <input type="hidden" name="ps" value="<%= p.ps %>">
    <div class="segmented"><%- seg('chart', p.chart, [['bars','Bars'],['lines','Lines']]) %></div>
    <div class="segmented"><%- seg('metric', p.metric, [['time','Working time'],['earnings','Earnings']]) %></div>
    <div class="segmented"><%- seg('by', p.by, [['task','Tasks'],['tag','Tags']]) %></div>
    <div class="segmented"><%- seg('type', p.type, [['week','Week'],['biweek','Biweek'],['month','Month'],['quarter','Quarter']]) %></div>
    <select name="clientId">
      <option value="">All clients</option>
      <% clients.forEach(c => { %><option value="<%= c.id %>" <%= p.clientId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
    <details class="dropdown">
      <summary>Tasks<%= p.taskIds.length ? ` (${p.taskIds.length})` : '' %></summary>
      <div class="menu">
        <% if (!menuTasks.length) { %><div class="mi">No tasks</div><% } %>
        <% menuTasks.forEach(t => { %>
          <label class="mi"><input type="checkbox" name="taskId" value="<%= t.id %>" <%= p.taskIds.includes(t.id) ? 'checked' : '' %>><span class="sw" style="background:<%= t.color %>"></span><%= esc(t.name) %></label>
        <% }) %>
      </div>
    </details>
    <details class="dropdown">
      <summary>Tags<%= p.tagIds.length ? ` (${p.tagIds.length})` : '' %></summary>
      <div class="menu">
        <% tags.forEach(t => { %>
          <label class="mi"><input type="checkbox" name="tagId" value="<%= t.id %>" <%= p.tagIds.includes(t.id) ? 'checked' : '' %>><span class="sw" style="background:<%= t.color %>"></span><%= esc(t.name) %></label>
        <% }) %>
      </div>
    </details>
  </form>

  <div class="an-periods">
    <% periods.forEach(per => { %>
      <button class="<%= per.selected ? 'sel' : '' %>"
              hx-get="/partials/analytics-panel?<%= base %>&ps=<%= per.ps %>"
              hx-target="#analytics" hx-swap="outerHTML"><%= per.label %></button>
    <% }) %>
  </div>

  <% if (report.grandTotal === 0) { %>
    <p class="empty">No completed work in <%= rangeLabel %>.</p>
  <% } else { %>
    <svg class="chart" viewBox="0 0 <%= W %> <%= H %>" preserveAspectRatio="none" role="img">
      <% [0, 0.5, 1].forEach(f => { const y = yB - f * plotH; %>
        <line x1="<%= x0 %>" y1="<%= y %>" x2="<%= x1 %>" y2="<%= y %>" stroke="var(--line)" stroke-width="1"/>
        <text x="<%= x0 - 6 %>" y="<%= y + 4 %>" text-anchor="end" font-size="11" fill="var(--muted)"><%= fmtVal(Math.round(max * f)) %></text>
      <% }) %>
      <% if (p.chart === 'bars') { %>
        <% buckets.forEach((d, i) => { let acc = 0; const bw = band * 0.68; const bx = x0 + i * band + (band - bw) / 2; %>
          <% series.forEach(s => { const v = s.values[i]; if (v <= 0) return; const h = (v / max) * plotH; const y = yB - acc - h; acc += h; %>
            <rect x="<%= bx %>" y="<%= y %>" width="<%= bw %>" height="<%= h %>" style="fill:<%= s.color %>"/>
          <% }) %>
        <% }) %>
      <% } else { %>
        <% series.forEach(s => { const pts = s.values.map((v, i) => `${(x0 + i * band + band / 2).toFixed(1)},${yOf(v).toFixed(1)}`).join(' '); %>
          <polyline points="<%= pts %>" fill="none" style="stroke:<%= s.color %>" stroke-width="2" stroke-linejoin="round"/>
        <% }) %>
      <% } %>
      <% buckets.forEach((d, i) => { if (i % step) return; %>
        <text x="<%= x0 + i * band + band / 2 %>" y="<%= H - 6 %>" text-anchor="middle" font-size="10" fill="var(--muted)"><%= d.label %></text>
      <% }) %>
    </svg>
    <ul class="legend">
      <% series.forEach(s => { %>
        <li><span class="sw" style="background:<%= s.color %>"></span><%= s.name %><span class="v"><%= fmtVal(s.total) %></span></li>
      <% }) %>
      <li class="total"><span class="sw" style="background:transparent"></span>Total<span class="v"><%= fmtVal(report.grandTotal) %></span></li>
    </ul>
  <% } %>

  <form class="an-export" method="get" action="/export.csv">
    <input type="hidden" name="type" value="<%= p.type %>">
    <input type="hidden" name="ps" value="<%= p.ps %>">
    <% if (p.clientId) { %><input type="hidden" name="clientId" value="<%= p.clientId %>"><% } %>
    <% p.taskIds.forEach(id => { %><input type="hidden" name="taskId" value="<%= id %>"><% }) %>
    <% p.tagIds.forEach(id => { %><input type="hidden" name="tagId" value="<%= id %>"><% }) %>
    <span class="an-export-note">Exports the current view</span>
    <button>Export CSV</button>
  </form>
</div>
