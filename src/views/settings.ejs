<%
  const opts = [[0,'Off'],[6,'6 min'],[10,'10 min'],[15,'15 min'],[30,'30 min'],[60,'1 hour']];
  const seg = opts.map(([v,label]) =>
    `<label class="seg${settings.rounding_minutes===v?' on':''}"><input type="radio" name="roundingMinutes" value="${v}" ${settings.rounding_minutes===v?'checked':''}><span>${label}</span></label>`
  ).join('');
  const groupOpts = [['day','Daily'],['week','Weekly'],['biweek','Biweekly'],['month','Monthly'],['quarter','Quarterly']];
  const groupSeg = groupOpts.map(([v,label]) =>
    `<label class="seg${settings.session_grouping===v?' on':''}"><input type="radio" name="sessionGrouping" value="${v}" ${settings.session_grouping===v?'checked':''}><span>${label}</span></label>`
  ).join('');
  const days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  const weekSel = days.map((label,v) =>
    `<option value="${v}" ${settings.week_start===v?'selected':''}>${label}</option>`
  ).join('');
  const esc = (s) => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const tagsBlock = include('partials/settings-tags', { tags, newTagColor });
  const body = `
    <h1>Settings</h1>
    ${error ? `<p class="err">${error}</p>` : ''}
    <form method="post" action="/settings" class="settings">
      <fieldset><legend>Round up working time to the next…</legend><div class="segmented">${seg}</div></fieldset>
      <fieldset><legend>Group sessions on the Time page by…</legend><div class="segmented">${groupSeg}</div></fieldset>
      <fieldset><legend>First day of the week</legend><select name="weekStart">${weekSel}</select></fieldset>
      <fieldset><legend>Invoice "From" default</legend><textarea name="businessFrom" rows="5" placeholder="Your business name, address, email, phone">${esc(settings.business_from)}</textarea></fieldset>
      <button type="submit">Save</button>
    </form>
    <h2>Tags</h2>
    ${tagsBlock}
    <form method="post" action="/logout" class="logout-form">
      <button class="danger">Log out</button>
    </form>
    <footer class="version">${version.hash} · ${version.builtAt}</footer>`;
%>
<%- include('layout', { title, nav, body }) %>
